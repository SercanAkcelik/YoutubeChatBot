<Window x:Class="YoutubeChatBotV2.View.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:YoutubeChatBotV2.View"
        mc:Ignorable="d"
        Title="YouTube Chat Bot v2" 
        Height="700" 
        Width="1100"
        Background="#FF0F0F0F"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="False"
        Closing="Window_Closing">
        
    
    <Window.Resources>
        <!-- Gradient Background -->
        <LinearGradientBrush x:Key="WindowGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF0F0F0F" Offset="0"/>
            <GradientStop Color="#FF1A1A1A" Offset="1"/>
        </LinearGradientBrush>

        
        
        <!-- Header Style -->
        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        
        <!-- Label Style -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        
        <!-- Title Bar Button Style -->
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                VerticalAlignment="Stretch">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#FF2A2A2A"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#FF1A1A1A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Close Button Special Style -->
        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFE81123"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- ListBox Style -->
        <Style x:Key="ModernListBox" TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer Focusable="False" 
                                          Padding="{TemplateBinding Padding}"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="12,10"/>
                        <Setter Property="Margin" Value="0,2"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Border" 
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="#FF2A2A2A"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="#FF2A2A2A"/>
                                            <Setter Property="Foreground" Value="{StaticResource AccentColor}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Grid Margin="0,0,0,0">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF0F0F0F" Offset="0"/>
                <GradientStop Color="#FF1A1A1A" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Custom Title Bar -->
        <Border Grid.Row="0" 
                VerticalAlignment="Top"
                Margin="0,0,0,0"
                Height="50">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#FF0F0F0F" Offset="0"/>
                    <GradientStop Color="#FF1A1A1A" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect Color="#40000000" Direction="270" ShadowDepth="2" BlurRadius="5" Opacity="0.8"/>
            </Border.Effect>
            
            <Grid VerticalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Title Bar Content -->
                <Grid Grid.Column="0" MouseDown="TitleBar_MouseDown" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" 
                                VerticalAlignment="Center" 
                                Margin="20,0,0,0">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource AccentColor}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock Text="YouTube Chat Bot" 
                                   FontSize="15" 
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="v2" 
                                   FontSize="11" 
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentColor}"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
                
                <!-- Divider -->
                <Border Grid.Column="0" 
                        Grid.ColumnSpan="2"
                        Background="{StaticResource BorderColor}"
                        Height="1"
                        VerticalAlignment="Bottom"/>
                
                <!-- Window Controls -->
                <StackPanel Grid.Column="1" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Right"
                            VerticalAlignment="Stretch">
                    <!-- Minimize Button -->
                    <Button x:Name="BtnMinimize"
                            Content="━"
                            Width="50"
                            Height="50"
                            Background="Transparent"
                            Foreground="{StaticResource TextSecondary}"
                            BorderThickness="0"
                            FontSize="16"
                            FontWeight="Bold"
                            Cursor="Hand"
                            Click="BtnMinimize_Click"
                            VerticalAlignment="Stretch"
                            Padding="0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" 
                                                    Background="Transparent" 
                                                    BorderThickness="0">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#FF2A2A2A"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#FF333333"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    
                    <!-- Maximize/Restore Button -->
                    <Button x:Name="BtnMaximize"
                            Content="◻"
                            Width="50"
                            Height="50"
                            Background="Transparent"
                            Foreground="{StaticResource TextSecondary}"
                            BorderThickness="0"
                            FontSize="14"
                            FontWeight="Bold"
                            Cursor="Hand"
                            Click="BtnMaximize_Click"
                            VerticalAlignment="Stretch"
                            Padding="0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" 
                                                    Background="Transparent" 
                                                    BorderThickness="0">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#FF2A2A2A"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#FF333333"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    
                    <!-- Close Button -->
                    <Button x:Name="BtnClose"
                            Content="✕"
                            Width="50"
                            Height="50"
                            Background="Transparent"
                            Foreground="{StaticResource TextSecondary}"
                            BorderThickness="0"
                            FontSize="16"
                            FontWeight="Bold"
                            Cursor="Hand"
                            Click="BtnClose_Click"
                            VerticalAlignment="Stretch"
                            Padding="0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" 
                                                    Background="Transparent" 
                                                    BorderThickness="0">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#FFE81123"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#FFCC0000"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Main Container -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Header -->
            <Border Grid.Row="0" 
                    Background="{StaticResource CardBackground}" 
                    CornerRadius="12" 
                    Padding="25,20"
                    Margin="0,0,0,20"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#40000000" Direction="315" ShadowDepth="4" BlurRadius="10" Opacity="0.5"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="📺 YouTube Chat Bot" 
                                   FontSize="32" 
                                   FontWeight="Bold" 
                                   Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="Yayın sohbetinizi yönetin ve otomatikleştirin" 
                                   FontSize="14" 
                                   Foreground="{StaticResource TextSecondary}"
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusIndicator" 
                                 Width="12" 
                                 Height="12" 
                                 Fill="{StaticResource WarningColor}" 
                                 Margin="0,0,8,0"/>
                        <TextBlock x:Name="StatusText" 
                                   Text="Hazır" 
                                   FontSize="14" 
                                   Foreground="{StaticResource TextSecondary}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- Tab Control -->
            <TabControl Grid.Row="1" 
                        Background="Transparent" 
                        BorderThickness="0"
                        ItemContainerStyle="{StaticResource ModernTabItem}">
                <TabControl.Resources>
                    <Style TargetType="TabControl">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabControl">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TabPanel x:Name="HeaderPanel" 
                                                  Grid.Row="0" 
                                                  IsItemsHost="True" 
                                                  Margin="0,0,0,15"/>
                                        <ContentPresenter x:Name="PART_SelectedContentHost" 
                                                          Grid.Row="1" 
                                                          Margin="0"
                                                          ContentSource="SelectedContent"/>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>
                
                <!-- 🤖 Bot Durumu Tab -->
                <TabItem x:Name="TabBotDurumu">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" x:Name="HeaderBotDurumu">
                            <TextBlock Text="🤖" FontSize="18" Margin="0,0,8,0" Foreground="#FFFFFFFF"/>
                            <TextBlock Text="Bot Durumu" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFFFF"/>
                        </StackPanel>
                    </TabItem.Header>
                    
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Control Panel Card -->
                        <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Kontrol Paneli" Style="{StaticResource HeaderTextStyle}" FontSize="24"/>
                                <TextBlock Text="Bot'u başlatın veya durdurun" 
                                           FontSize="13" 
                                           Foreground="{StaticResource TextSecondary}"
                                           Margin="0,0,0,20"/>
                                
                                <!-- Kanal Linki -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                    <StackPanel  Margin="0,0,15,0">
                                        <TextBlock Text="YouTube Kanal Linki" Style="{StaticResource LabelStyle}"/>
                                        <TextBox x:Name="TxtChannelLink"
                                                 Style="{StaticResource ModernTextBox}"
                                                 Text="https://www.youtube.com/channel/..."
                                                 FontSize="13"/>
                                    </StackPanel>
                                    <Button x:Name="BtnSaveChannelLink" 
                                            Content="💾 Kaydet" 
                                            Style="{StaticResource ModernButton}"
                                            Width="140"
                                            Height="45"
                                            VerticalAlignment="Bottom"
                                            Margin="0,0,0,0"
                                            Click="BtnSaveChannelLink_Click"/>
                                </StackPanel>
                                
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <Button x:Name="BtnStart" 
                                            Content="▶ Botu Başlat" 
                                            Style="{StaticResource ModernButton}"
                                            Width="180" 
                                            Height="45"
                                            FontSize="15"
                                            Click="BtnStart_Click"/>
                                    
                                    <Button x:Name="BtnStop" 
                                            Content="⛔ Botu Durdur" 
                                            Style="{StaticResource SecondaryButton}"
                                            Width="180" 
                                            Height="45"
                                            FontSize="15"
                                            Margin="15,0,0,0"
                                            Click="BtnStop_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        
                        <!-- Log Panel Card - İkili Yapı -->
                        <Border Grid.Row="1">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                    <Setter Property="Margin" Value="0"/>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                
                                <!-- Sol Panel Header -->
                                <StackPanel Grid.Column="0" Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="⚙️" FontSize="18" Margin="0,0,8,0"/>
                                    <TextBlock Text="Sistem Logları" 
                                               Style="{StaticResource HeaderTextStyle}" 
                                               FontSize="16"/>
                                </StackPanel>
                                
                                <!-- Sol Panel: Sistem Logları -->
                                <TextBox x:Name="TxtLog"
                                         Grid.Column="0" Grid.Row="1"
                                         Style="{StaticResource ModernTextBox}"
                                         MinHeight="150"
                                         MaxHeight="280"
                                         AcceptsReturn="True"
                                         IsReadOnly="True"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Disabled"
                                         TextWrapping="Wrap"
                                         FontFamily="Consolas"
                                         FontSize="11"/>
                                
                                <!-- Sağ Panel Header -->
                                <StackPanel Grid.Column="2" Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="💬" FontSize="18" Margin="0,0,8,0"/>
                                    <TextBlock Text="Canlı Chat" 
                                               Style="{StaticResource HeaderTextStyle}" 
                                               FontSize="16"/>
                                </StackPanel>
                                
                                <!-- Sağ Panel: Canlı Chat -->
                                <TextBox x:Name="TxtChatLog"
                                         Grid.Column="2" Grid.Row="1"
                                         Style="{StaticResource ModernTextBox}"
                                         MinHeight="150"
                                         MaxHeight="280"
                                         AcceptsReturn="True"
                                         IsReadOnly="True"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Disabled"
                                         TextWrapping="Wrap"
                                         FontFamily="Consolas"
                                         FontSize="11"/>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
                
                <!-- 🧩 Komutlar Tab -->
                <TabItem x:Name="TabKomutlar">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" x:Name="HeaderKomutlar">
                            <TextBlock Text="🧩" FontSize="18" Margin="0,0,8,0" Foreground="#FFFFFFFF"/>
                            <TextBlock Text="Komutlar" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFFFF"/>
                        </StackPanel>
                    </TabItem.Header>
                    
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Add Command Card -->
                        <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Yeni Komut Ekle" Style="{StaticResource HeaderTextStyle}" FontSize="24"/>
                                <TextBlock Text="İzleyicilerin kullanabileceği yeni komutlar oluşturun" 
                                           FontSize="13" 
                                           Foreground="{StaticResource TextSecondary}"
                                           Margin="0,0,0,25"/>
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <!-- Prefix Input -->
                                    <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,0,15,0" Width="80">
                                        <TextBlock Text="Simge" Style="{StaticResource LabelStyle}"/>
                                        <TextBox x:Name="TxtPrefix"
                                                 Style="{StaticResource ModernTextBox}"
                                                 Text="!"
                                                 TextAlignment="Center"
                                                 FontSize="16"
                                                 FontWeight="Bold"/>
                                    </StackPanel>
                                    
                                    <!-- Command Input -->
                                    <StackPanel Grid.Column="1" Grid.Row="1" Margin="0,0,15,0">
                                        <TextBlock Text="Komut Adı" Style="{StaticResource LabelStyle}"/>
                                        <TextBox x:Name="TxtCommand"
                                                 Style="{StaticResource ModernTextBox}"/>
                                    </StackPanel>
                                    
                                    <!-- Response Input -->
                                    <StackPanel Grid.Column="2" Grid.Row="1" Margin="0,0,15,0">
                                        <TextBlock Text="Bot Yanıtı" Style="{StaticResource LabelStyle}"/>
                                        <TextBox x:Name="TxtResponse"
                                                 Style="{StaticResource ModernTextBox}"/>
                                    </StackPanel>
                                    
                                    <!-- Action Buttons -->
                                    <StackPanel Grid.Column="3" 
                                                Orientation="Horizontal" 
                                                VerticalAlignment="Bottom">
                                        <Button Content="➕ Kaydet" 
                                                Style="{StaticResource ModernButton}"
                                                Width="110"
                                                Height="45"
                                                Margin="0,0,8,0"
                                                Click="BtnAddCommand_Click"/>
                                        <Button Content="✏ Düzenle" 
                                                Style="{StaticResource PrimaryButton}"
                                                Width="110"
                                                Height="45"
                                                Margin="0,0,8,0"
                                                Click="BtnEditCommand_Click"/>
                                        <Button Content="🗑 Sil" 
                                                Width="90"
                                                Height="45"
                                                Background="#FFEF476F"
                                                Foreground="White"
                                                Click="BtnDeleteCommand_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="8" BorderThickness="0">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#FFDB3D5A"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter Property="Background" Value="#FFC02E4C"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                        
                        <!-- Commands List Card -->
                        <Border Grid.Row="1">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                    <Setter Property="Margin" Value="0"/>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                    <TextBlock Text="📋" FontSize="20" Margin="0,0,10,0"/>
                                    <TextBlock Text="Mevcut Komutlar" 
                                               Style="{StaticResource HeaderTextStyle}" 
                                               FontSize="22"/>
                                </StackPanel>
                                
                                <ListBox x:Name="LstCommands"
                                         Style="{StaticResource ModernListBox}"
                                         MinHeight="150"
                                         MaxHeight="280"
                                         SelectionMode="Single"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>
                
                <!-- ⏱️ Otomatik Mesaj Tab -->
                <TabItem x:Name="TabOtomatikMesajlar">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" x:Name="HeaderOtomatikMesajlar">
                            <TextBlock Text="⏱️" FontSize="18" Margin="0,0,8,0" Foreground="#FFFFFFFF"/>
                            <TextBlock Text="Otomatik Mesajlar" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFFFF"/>
                        </StackPanel>
                    </TabItem.Header>
                    <TabItem.Content>
                        <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Add Auto Message Card -->
                        <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Yeni Otomatik Mesaj" Style="{StaticResource HeaderTextStyle}" FontSize="24"/>
                                <TextBlock Text="Belirli aralıklarla otomatik olarak gönderilecek mesajlar ekleyin" 
                                           FontSize="13" 
                                           Foreground="{StaticResource TextSecondary}"
                                           Margin="0,0,0,25"/>
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <!-- Message Input -->
                                    <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,0,15,0">
                                        <TextBlock Text="Mesaj İçeriği" Style="{StaticResource LabelStyle}"/>
                                        <TextBox x:Name="TxtAutoMessage"
                                                 Style="{StaticResource ModernTextBox}"/>
                                    </StackPanel>
                                    
                                    <!-- Interval Input -->
                                    <StackPanel Grid.Column="1" Grid.Row="1" Margin="0,0,15,0" Width="120">
                                        <TextBlock Text="Süre (Saniye)" Style="{StaticResource LabelStyle}"/>
                                        <TextBox x:Name="TxtAutoInterval"
                                                 Style="{StaticResource ModernTextBox}"
                                                 TextAlignment="Center"/>
                                    </StackPanel>
                                    
                                    <!-- Action Buttons -->
                                    <StackPanel Grid.Column="2" 
                                                Orientation="Horizontal" 
                                                VerticalAlignment="Bottom">
                                        <Button Content="➕ Kaydet" 
                                                Style="{StaticResource ModernButton}"
                                                Width="110"
                                                Height="45"
                                                Margin="0,0,8,0"
                                                Click="BtnAddAutoMessage_Click"/>
                                        <Button Content="✏ Düzenle" 
                                                Style="{StaticResource PrimaryButton}"
                                                Width="110"
                                                Height="45"
                                                Margin="0,0,8,0"
                                                Click="BtnEditAutoMessage_Click"/>
                                        <Button Content="🗑 Sil" 
                                                Width="90"
                                                Height="45"
                                                Background="#FFEF476F"
                                                Foreground="White"
                                                Click="BtnDeleteAutoMessage_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="8" BorderThickness="0">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#FFDB3D5A"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter Property="Background" Value="#FFC02E4C"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                        
                        <!-- Auto Messages List Card -->
                        <Border Grid.Row="1">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                    <Setter Property="Margin" Value="0"/>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                    <TextBlock Text="📨" FontSize="20" Margin="0,0,10,0"/>
                                    <TextBlock Text="Mevcut Otomatik Mesajlar" 
                                               Style="{StaticResource HeaderTextStyle}" 
                                               FontSize="22"/>
                                </StackPanel>
                                
                                <ListBox x:Name="LstAutoMessages"
                                         Style="{StaticResource ModernListBox}"
                                         MinHeight="150"
                                         MaxHeight="280"
                                         SelectionMode="Single"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    </TabItem.Content>
                </TabItem>
                
                <!-- 🛡️ Moderasyon Tab -->
                <TabItem x:Name="TabModerasyon">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" x:Name="HeaderModerasyon">
                            <TextBlock Text="🛡️" FontSize="18" Margin="0,0,8,0" Foreground="#FFFFFFFF"/>
                            <TextBlock Text="Moderasyon" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFFFF"/>
                        </StackPanel>
                    </TabItem.Header>
                    <TabItem.Content>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                            <StackPanel>
                                <!-- Header -->
                                <Border Margin="0,0,0,20">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                            <Setter Property="Margin" Value="0"/>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <TextBlock Text="🛡️" FontSize="24" Margin="0,0,12,0"/>
                                            <TextBlock Text="Moderasyon Filtreleri" 
                                                       Style="{StaticResource HeaderTextStyle}" 
                                                       FontSize="22"/>
                                        </StackPanel>
                                        <TextBlock Text="Chat mesajlarını otomatik filtrele ve moderasyonu yönet" 
                                                   Foreground="#99FFFFFF" FontSize="13"/>
                                    </StackPanel>
                                </Border>
                                
                                <!-- Filter Kartları Grid -->
                                <ItemsControl x:Name="FilterCardsContainer">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem.Content>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>