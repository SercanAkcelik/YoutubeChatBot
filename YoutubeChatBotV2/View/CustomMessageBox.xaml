<Window x:Class="YoutubeChatBotV2.View.CustomMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CustomMessageBox" 
        Height="200" 
        Width="500"
        Background="#FF1A1A1A"
        Foreground="#FFEBEBEB"
        WindowStartupLocation="CenterOwner"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="Height">
    
    <Grid Background="#FF1A1A1A" Margin="0">
        <StackPanel VerticalAlignment="Stretch" Margin="20">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                <TextBlock x:Name="TitleBlock" 
                           FontSize="16" 
                           FontWeight="Bold" 
                           Foreground="#FFEBEBEB"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
            </StackPanel>
            
            <TextBlock x:Name="MessageBlock" 
                       FontSize="13" 
                       Foreground="#FFA0A0A0"
                       TextWrapping="Wrap"
                       Margin="0,0,0,20"
                       LineHeight="20"/>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button x:Name="OkButton" 
                        Content="Tamam" 
                        Width="100" 
                        Height="32"
                        Background="#FF0066E0"
                        Foreground="#FFEBEBEB"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="OkButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
